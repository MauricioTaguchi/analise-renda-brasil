{
  "name": "BrazilIncome",
  "compatibilityLevel": 1567,
  "model": {
    "culture": "en-US",
    "defaultPowerBIDataSourceVersion": "powerBI_V3",
    "sourceQueryCulture": "en-US",
    "tables": [
      {
        "name": "Income",
        "columns": [
          {
            "name": "quarter_code",
            "dataType": "int64",
            "sourceColumn": "quarter_code",
            "summarizeBy": "none"
          },
          {
            "name": "state_code",
            "dataType": "int64",
            "sourceColumn": "state_code",
            "summarizeBy": "none"
          },
          {
            "name": "income_real_brl",
            "dataType": "double",
            "sourceColumn": "income_real_brl",
            "summarizeBy": "none"
          }
        ],
        "partitions": [
          {
            "name": "Income",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Source = Table.FromRows(Json.Document(Binary.FromText(\"\", BinaryEncoding.Base64)), type table [quarter_code=Int64.Type, state_code=Int64.Type, income_real_brl=number])",
                "in",
                "    Source"
              ]
            }
          }
        ],
        "measures": [
          {
            "name": "Income - unweighted state mean",
            "expression": "VAR p = MAX(Quarters[quarter_code]) RETURN CALCULATE(AVERAGE(Income[income_real_brl]), REMOVEFILTERS(Quarters), Quarters[quarter_code] = p)",
            "formatString": "\"BRL \"#,0.00"
          },
          {
            "name": "Federal units in view",
            "expression": "VAR p = MAX(Quarters[quarter_code]) RETURN CALCULATE(DISTINCTCOUNT(Income[state_code]), REMOVEFILTERS(Quarters), Quarters[quarter_code] = p)",
            "formatString": "0"
          },
          {
            "name": "Prior year income",
            "expression": "VAR p = MAX(Quarters[quarter_code]) - 100 RETURN CALCULATE(AVERAGE(Income[income_real_brl]), REMOVEFILTERS(Quarters), Quarters[quarter_code] = p)",
            "formatString": "\"BRL \"#,0.00"
          },
          {
            "name": "Prior year federal units",
            "expression": "VAR p = MAX(Quarters[quarter_code]) - 100 RETURN CALCULATE(DISTINCTCOUNT(Income[state_code]), REMOVEFILTERS(Quarters), Quarters[quarter_code] = p)",
            "formatString": "0"
          },
          {
            "name": "YoY change",
            "expression": "IF([Federal units in view] = [Prior year federal units] && [Prior year federal units] > 0, DIVIDE([Income - unweighted state mean] - [Prior year income], [Prior year income]), BLANK())",
            "formatString": "0.00%;-0.00%;0.00%"
          }
        ]
      },
      {
        "name": "States",
        "columns": [
          {
            "name": "state_code",
            "dataType": "int64",
            "sourceColumn": "state_code",
            "summarizeBy": "none"
          },
          {
            "name": "state",
            "dataType": "string",
            "sourceColumn": "state",
            "summarizeBy": "none"
          },
          {
            "name": "region",
            "dataType": "string",
            "sourceColumn": "region",
            "summarizeBy": "none"
          }
        ],
        "partitions": [
          {
            "name": "States",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Source = Table.FromRows(Json.Document(Binary.FromText(\"\", BinaryEncoding.Base64)), type table [state_code=Int64.Type, state=text, region=text])",
                "in",
                "    Source"
              ]
            }
          }
        ]
      },
      {
        "name": "Quarters",
        "columns": [
          {
            "name": "quarter_code",
            "dataType": "int64",
            "sourceColumn": "quarter_code",
            "summarizeBy": "none"
          },
          {
            "name": "quarter",
            "dataType": "string",
            "sourceColumn": "quarter",
            "summarizeBy": "none",
            "sortByColumn": "quarter_code"
          }
        ],
        "partitions": [
          {
            "name": "Quarters",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Source = Table.FromRows(Json.Document(Binary.FromText(\"\", BinaryEncoding.Base64)), type table [quarter_code=Int64.Type, quarter=text])",
                "in",
                "    Source"
              ]
            }
          }
        ]
      }
    ],
    "relationships": [
      {
        "name": "IncomeStates",
        "fromTable": "Income",
        "fromColumn": "state_code",
        "toTable": "States",
        "toColumn": "state_code",
        "fromCardinality": "many",
        "toCardinality": "one",
        "crossFilteringBehavior": "oneDirection"
      },
      {
        "name": "IncomeQuarters",
        "fromTable": "Income",
        "fromColumn": "quarter_code",
        "toTable": "Quarters",
        "toColumn": "quarter_code",
        "fromCardinality": "many",
        "toCardinality": "one",
        "crossFilteringBehavior": "oneDirection"
      }
    ],
    "annotations": [
      {
        "name": "__PBI_TimeIntelligenceEnabled",
        "value": "0"
      }
    ]
  }
}
