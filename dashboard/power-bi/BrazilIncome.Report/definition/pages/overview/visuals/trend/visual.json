{
  "$schema": "https://developer.microsoft.com/json-schemas/fabric/item/report/definition/visualContainer/1.0.0/schema.json",
  "name": "trend",
  "position": {
    "x": 650,
    "y": 160,
    "z": 0,
    "width": 590,
    "height": 330,
    "tabOrder": 0
  },
  "visual": {
    "visualType": "lineChart",
    "query": {
      "queryState": {
        "Category": {
          "projections": [
            {
              "field": {
                "Column": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "Quarters"
                    }
                  },
                  "Property": "quarter"
                }
              },
              "queryRef": "Quarters.quarter",
              "nativeQueryRef": "quarter"
            }
          ]
        },
        "Y": {
          "projections": [
            {
              "field": {
                "Measure": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "Income"
                    }
                  },
                  "Property": "Income - unweighted state mean"
                }
              },
              "queryRef": "Income.Income - unweighted state mean",
              "nativeQueryRef": "Income - unweighted state mean"
            }
          ]
        }
      }
    },
    "visualContainerObjects": {
      "title": [
        {
          "properties": {
            "show": {
              "expr": {
                "Literal": {
                  "Value": "true"
                }
              }
            },
            "text": {
              "expr": {
                "Literal": {
                  "Value": "'Income in the selected quarter scope'"
                }
              }
            }
          }
        }
      ]
    },
    "drillFilterOtherVisuals": true
  }
}
