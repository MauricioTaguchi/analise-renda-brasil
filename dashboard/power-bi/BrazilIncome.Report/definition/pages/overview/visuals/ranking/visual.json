{
  "$schema": "https://developer.microsoft.com/json-schemas/fabric/item/report/definition/visualContainer/1.0.0/schema.json",
  "name": "ranking",
  "position": {
    "x": 20,
    "y": 160,
    "z": 0,
    "width": 600,
    "height": 530,
    "tabOrder": 0
  },
  "visual": {
    "visualType": "clusteredBarChart",
    "query": {
      "queryState": {
        "Category": {
          "projections": [
            {
              "field": {
                "Column": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "States"
                    }
                  },
                  "Property": "state"
                }
              },
              "queryRef": "States.state",
              "nativeQueryRef": "state"
            }
          ]
        },
        "Y": {
          "projections": [
            {
              "field": {
                "Measure": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "Income"
                    }
                  },
                  "Property": "Income - unweighted state mean"
                }
              },
              "queryRef": "Income.Income - unweighted state mean",
              "nativeQueryRef": "Income - unweighted state mean"
            }
          ]
        }
      }
    },
    "visualContainerObjects": {
      "title": [
        {
          "properties": {
            "show": {
              "expr": {
                "Literal": {
                  "Value": "true"
                }
              }
            },
            "text": {
              "expr": {
                "Literal": {
                  "Value": "'Federal-unit comparison - BRL'"
                }
              }
            }
          }
        }
      ]
    },
    "drillFilterOtherVisuals": true
  }
}
